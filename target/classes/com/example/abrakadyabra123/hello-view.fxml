<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="171.0" prefWidth="298.0" spacing="20.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.abrakadyabra123.HelloController">
    <padding>
        <Insets bottom="20.0" left="5.0" right="35.0" top="20.0" />
    </padding>


    <Button fx:id="buttonLeft" onAction="#onLeftButtonClick" text="Left1" />
   <Button fx:id="buttonRight" alignment="CENTER_RIGHT" contentDisplay="RIGHT" onAction="#onRightButtonClick" text="Right2" translateX="100.0" translateY="-45.0">
      <opaqueInsets>
         <Insets />
      </opaqueInsets></Button>
   <Label fx:id="text" prefHeight="17.0" prefWidth="55.0" text="надпись " />
   <Button fx:id="button" mnemonicParsing="false" onAction="#onbuttonButtonClick" prefHeight="25.0" prefWidth="52.0" text="Color" translateX="100.0" translateY="-45.0" />
   <Label fx:id="textError" opacity="0.0" text="error" textFill="RED" />
    <padding>
        <Insets bottom="20.0" left="35.0" right="5.0" top="20.0" />
    </padding>
</VBox>
