<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="277.0" prefWidth="560.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.abrakadyabra123.HelloController">
   <children>
      <VBox prefHeight="277.0" prefWidth="111.0">
         <children>
            <Button fx:id="buttonGreen" mnemonicParsing="false" onAction="#onGreenButtonClick" text="Green" translateX="25.0" translateY="3.0">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="buttonPurple" mnemonicParsing="false" onAction="#onPurpleButtonClick" text="Purple" translateX="25.0" translateY="3.0">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="buttonBlack" mnemonicParsing="false" onAction="#onBlackButtonClick" text="Black" translateX="25.0" translateY="3.0">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="buttonBlue" mnemonicParsing="false" onAction="#onBlueButtonClick" text="Blue" translateX="25.0" translateY="3.0">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Label fx:id="text" prefHeight="36.0" prefWidth="110.0" text="        Надпись" textAlignment="CENTER" translateY="6.0" />
            <Label fx:id="textError" opacity="0.0" prefHeight="123.0" prefWidth="116.0" text="Нажмите на любую другую кнопку" textAlignment="CENTER" textFill="RED" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <HBox prefHeight="277.0" prefWidth="453.0">
         <children>
            <VBox prefHeight="277.0" prefWidth="405.0">
               <children>
                  <TextField fx:id="myTextField" prefHeight="141.0" prefWidth="397.0" promptText="Введите текст" />
                  <Label fx:id="textEnter" prefHeight="137.0" prefWidth="397.0" />
               </children>
            </VBox>
            <Button fx:id="buttonEnter" mnemonicParsing="false" onAction="#enterInput" text="Enter" />
         </children>
      </HBox>
   </children>
</HBox>
