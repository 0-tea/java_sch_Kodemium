<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="280.0" prefWidth="240.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.abrakadyabra123.PlayerChoiceSceneController">
   <children>
      <Label layoutX="14.0" layoutY="14.0" prefHeight="20.0" prefWidth="67.0" text="1 Player" />
      <TextField fx:id="PlayChoice_Player1" layoutX="14.0" layoutY="34.0" prefHeight="36.0" prefWidth="187.0" promptText="Nick" />
      <Label layoutX="14.0" layoutY="79.0" prefHeight="20.0" prefWidth="67.0" text="2 Player" />
      <TextField fx:id="PlayChoice_Player2" layoutX="14.0" layoutY="99.0" prefHeight="36.0" prefWidth="187.0" promptText="Nick" />
      <Label fx:id="PlayChoice_P1_goes" layoutX="211.0" layoutY="43.0" prefHeight="27.0" prefWidth="15.0" text="0" />
      <Label layoutX="201.0" layoutY="16.0" text="Goes:" />
      <Label fx:id="PlayChoice_P2_goes" layoutX="211.0" layoutY="108.0" prefHeight="27.0" prefWidth="15.0" text="X" />
      <Button fx:id="PlayChoice_StartBut" layoutX="11.0" layoutY="250.0" mnemonicParsing="false" onAction="#CLICK_PlayChoice_StartBut" text="Start game" />
      <Button fx:id="PlayChoice_ExitBut" layoutX="194.0" layoutY="250.0" mnemonicParsing="false" onAction="#CLICK_PlayChoice_ExitBut" text="Exit" />
      <Button fx:id="PlayChoice_ChangeGoBut" layoutX="137.0" layoutY="147.0" mnemonicParsing="false" onAction="#CLICK_PlayChoice_ChangeGoBut" prefHeight="30.0" prefWidth="92.0" text="Change goes" />
   </children>
</AnchorPane>
